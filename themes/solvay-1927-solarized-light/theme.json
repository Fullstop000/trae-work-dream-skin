      },
      "imChannel": {
        "src": "dialogue.svg",
        "selector": "body.trae-skin-theme-solvay-1927-solarized-light .task-list-skills-item:has(.task-list-new-task-text) > svg.add-icon:not(.trae-icon)"
      }
